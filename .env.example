# Coffee on QR · Kisan Sahayak — environment variables.
# Copy to .env.local (never commit real values). Everything is optional for a
# local demo: without DATABASE_URL an embedded database is used, and every
# provider below falls back to a clearly labelled demo mode.
# Never put a secret in a NEXT_PUBLIC_* variable.

# --- Core (set both in production) -----------------------------------------
# PostgreSQL connection string. Empty tables are migrated + seeded on first use.
DATABASE_URL=
# Long random string used to sign session cookies: `openssl rand -base64 32`
AUTH_SECRET=
# Public URL of this deployment (used for payment return URLs). Not a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI assistant + vision (first key found is used) -----------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Gemini key from Google AI Studio (GEMINI_API_KEY is accepted as an alias)
GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-3.5-flash-lite

# --- Speech (Hindi / Marathi voice notes) ----------------------------------
# Sarvam AI is preferred for Indian languages; OPENAI_API_KEY is the fallback.
SARVAM_API_KEY=

# --- Image storage ----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WhatsApp Business Cloud API (see docs/whatsapp-setup.md) --------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v23.0

# --- Cashfree payment gateway (see docs/cashfree-setup.md) -----------------
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
# CASHFREE_API_VERSION=2025-01-01
# Payouts credentials are detected but real disbursement is not implemented.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=
