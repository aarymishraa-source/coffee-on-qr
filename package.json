{
  "name": "coffee-on-qr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/embed-migrations.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "postinstall": "prisma generate && tsx scripts/embed-migrations.ts",
    "db:generate": "sh scripts/db-generate.sh",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "demo:reset": "tsx --conditions=react-server scripts/demo-reset.ts",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "shoot": "node scripts/shoot.mjs",
    "responsive": "node scripts/responsive.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@hookform/resolvers": "^5.9.2",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "^2.3.4",
    "@langchain/openai": "^1.7.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.5",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^14.3.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.13",
    "langchain": "^1.5.19",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pglite-prisma-adapter": "^0.7.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "0.128.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
